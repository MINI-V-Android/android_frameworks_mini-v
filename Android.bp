aidl_interface {
    name: "mini-v-aidl",
    srcs: [
        "aidl/com/miniv/ai/IMINIVAIService.aidl",
        "aidl/com/miniv/ai/ILLMStreamCallback.aidl",
    ],
    local_include_dir: "aidl",
    unstable: true,
    backend: {
        java: {
            enabled: true,
        },
    },
}

java_library {
    name: "mini-v-service",
    srcs: [
        "java/com/miniv/ai/engine/LLMEngine.java",
        "java/com/miniv/ai/engine/SimpleLLMEngine.java",
        "java/com/miniv/ai/engine/VendorNpuLLMEngine.java",
        "java/com/miniv/ai/service/MINIVAIService.java",
    ],
    static_libs: [
        "mini-v-aidl-java",
        "vendor-miniv-ai-aidl-V1-java",
    ],
    libs: [
        "framework",
    ],
    sdk_version: "",
    platform_apis: true,
}